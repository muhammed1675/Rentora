# Vercel serverless functions (frontend/api/*) — set these in Vercel
# Project Settings → Environment Variables, NOT here in the repo.

# Comma-separated list of origins allowed to call the payment/admin
# endpoints (Korapay confirmation, admin refunds, and related APIs).
# Used by _cors.js. Without this set, only localhost dev origins are allowed.
ALLOWED_ORIGINS=https://rentora.com.ng,https://www.rentora.com.ng

# Supabase service role — server-side only, bypasses RLS. Keep secret.
# Also read by og-property.js (link-preview bot handler — see vercel.json)
# to look up a single approved property's public fields.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Korapay credentials (server-side only)
KORAPAY_SECRET_KEY=your-korapay-secret-key
# Optional webhook signing secret
KORAPAY_WEBHOOK_SECRET=your-korapay-webhook-secret

# Resend (transactional email) — used by the contact-form admin reply
# (send-reply.js), via frontend/api/_email-config.js. Admin replies always
# come from this address in Phase 1 (no subject-based routing).
RESEND_API_KEY=re_xxx
EMAIL_ADDR_SUPPORT=support@rentora.com.ng

# NOTE: FROM_EMAIL is no longer read by any active code path (send-reply.js
# now uses EMAIL_ADDR_SUPPORT above). It only remains referenced by
# send-email.js, which is unused/dead code — see SETUP.md.
