# Vercel serverless functions (frontend/api/*) — set these in Vercel
# Project Settings → Environment Variables, NOT here in the repo.

# Supabase service role — server-side only, bypasses RLS. Keep secret.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Korapay secret key (server-side only)
KORALPAY_SECRET_KEY=sk_test_xxx

# Resend (transactional email) — used by contact form
RESEND_API_KEY=re_xxx
FROM_EMAIL=no-reply@yourdomain.com
