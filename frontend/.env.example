# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit the filled-in file.

# Supabase — Dashboard → Project Settings → API
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# Flutterwave — Dashboard → Settings → API Keys (use the PUBLIC key here)
REACT_APP_FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxx-X
