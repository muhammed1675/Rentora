# Frontend (client-side, browser-exposed) environment variables.
# Anything prefixed REACT_APP_ is baked into the JS bundle at build time
# and is visible to anyone who views source — never put a secret key here.

# Supabase — anon key is safe for the browser (RLS enforces access control)
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Flutterwave PUBLIC key only (never the secret key — that lives server-side
# in frontend/api/.env.example instead)
REACT_APP_FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxx-X

# Web Push (browser push notifications) — public VAPID key, safe to expose.
# Generate a pair with `npx web-push generate-vapid-keys`; the private half
# is NOT used anywhere in this repo yet (see SETUP.md §11 — the send-side
# edge function doesn't exist, so subscribing currently has no effect).
REACT_APP_VAPID_PUBLIC_KEY=

# NOTE: REACT_APP_RESEND_API_KEY and REACT_APP_BASE_URL are referenced only
# by src/lib/emailService.js, which is dead code (nothing imports it — all
# real email sending goes through Supabase Edge Functions / frontend/api
# instead). Do NOT set REACT_APP_RESEND_API_KEY: it would ship a real
# Resend secret key inside the public JS bundle. See SETUP.md §11.
