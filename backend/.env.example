# Optional Python backend (backend/server.py). Only needed if you run the
# auxiliary Python service; the main app runs frontend + Supabase only.
#
# These names must match exactly what backend/server.py reads via
# os.environ.get(...) — they are NOT the same names used in
# frontend/api/.env.example or supabase/functions/.env.example.

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional legacy service only; the production frontend uses Korapay.
KORAPAY_SECRET_KEY=sk_test_xxx
KORAPAY_WEBHOOK_SECRET=your-webhook-secret

# Comma-separated list of allowed CORS origins. Defaults to "*" (open) if unset.
CORS_ORIGINS=https://rentora.com.ng,https://www.rentora.com.ng
