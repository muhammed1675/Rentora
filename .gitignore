# ============================================================
# Rentora — root .gitignore
# Covers frontend/ (Create React App + Vercel serverless functions),
# backend/ (optional Python service), and supabase/functions/ (Deno).
# ============================================================

# ── Secrets — never commit real values ──────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
supabase/.env
supabase/functions/.env

# ── Dependencies ──────────────────────────────────────────────
node_modules/
frontend/node_modules/
**/node_modules/

# ── Build output ────────────────────────────────────────────
frontend/build/
frontend/dist/
build/
dist/
.vercel/

# ── Python (backend/) ───────────────────────────────────────
backend/__pycache__/
backend/venv/
backend/.venv/
**/__pycache__/
*.pyc

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── Editor / OS junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Supabase CLI local state ────────────────────────────────
supabase/.temp/
supabase/.branches/