# Supabase Edge Functions secrets. Set with:
#   supabase secrets set FLW_SECRET_KEY=... RESEND_API_KEY=... \
#     EMAIL_ADDR_SUPPORT=... EMAIL_ADDR_BILLING=... EMAIL_ADDR_NOREPLY=...
# Do NOT commit real values.

FLW_SECRET_KEY=sk_test_xxx
RESEND_API_KEY=re_xxx

# Sender addresses read by supabase/functions/_shared/email-config.ts.
# All three must be verified sending addresses on the same Resend domain.
# Each falls back to its rentora.com.ng default if unset — only override
# these if the address itself is changing (e.g. a domain migration).
EMAIL_ADDR_SUPPORT=support@rentora.com.ng
EMAIL_ADDR_BILLING=billing@rentora.com.ng
EMAIL_ADDR_NOREPLY=noreply@rentora.com.ng
